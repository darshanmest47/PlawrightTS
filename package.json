{
  "name": "playwright01",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx playwright test tests/PlaywrightGroupsHooks/annotations.spec.ts --headed --project chromium",
    "dev1": "npx playwright test tests/PlaywrightGroupsHooks/hooks.spec.ts --headed --project chromium",
    "_comment1": "Automatically adds the test steps & locators etc in the directory testsPlaywrightGroupsHooks/teststeps.spec.ts",
    "codegen": "npx playwright codegen -o testsPlaywrightGroupsHooks/teststeps.spec.ts",
    "group": "npx playwright test --grep \"Cart Functionality\" --headed --project chromium",
    "smoke": "npx playwright test tests/PlaywrightGroupsHooks/tags.spec.ts --project chromium --grep \"@smoke\"",
    "regression": "npx playwright test tests/PlaywrightGroupsHooks/tags.spec.ts --project chromium --grep \"@regression\"",
    "ortags": "npx playwright test tests/PlaywrightGroupsHooks/tags.spec.ts --project chromium --grep \"@smoke|@regression\"",
    "andtags": "npx playwright test tests/PlaywrightGroupsHooks/tags.spec.ts --project chromium --grep \"(?=.*@smoke)(?=.*@regression)\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0"
  }
}
